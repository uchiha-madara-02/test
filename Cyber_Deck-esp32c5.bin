<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#0e131c">
<title>ESP32 File Manager</title>
<style>
:root{
  --bg:#0e131c;--panel:#161d2a;--panel2:#1d2636;--line:#28334a;
  --text:#e6ebf5;--mute:#8592ab;--acc:#5eead4;--acc-d:#0f3f3a;--danger:#f87171;--folder:#f5c26b;
  --r:12px
}
*{box-sizing:border-box}
html{color-scheme:dark}
body{margin:0;background:var(--bg);color:var(--text);font:14px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;-webkit-tap-highlight-color:transparent}
button,input{font:inherit;color:inherit}
svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}
:focus-visible{outline:2px solid var(--acc);outline-offset:2px}

.app{max-width:860px;margin:0 auto;padding:0 14px 40px}
header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:18px 0 14px}
.brand{display:flex;align-items:center;gap:10px;font-size:17px;font-weight:650;letter-spacing:.2px}
.brand .logo{width:34px;height:34px;border-radius:9px;background:var(--acc-d);color:var(--acc);display:grid;place-items:center}
.brand small{display:block;font-size:12px;font-weight:400;color:var(--mute)}

.seg{display:inline-flex;background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:3px}
.seg button{display:flex;align-items:center;gap:6px;border:0;background:none;padding:7px 12px;border-radius:7px;cursor:pointer;color:var(--mute);transition:background .15s,color .15s}
.seg button.on{background:var(--acc-d);color:var(--acc)}
.seg button:disabled{opacity:.35;cursor:not-allowed}

.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);overflow:hidden}
.crumbs{display:flex;align-items:center;flex-wrap:wrap;gap:2px;padding:12px 14px;border-bottom:1px solid var(--line);font-size:13px}
.crumbs button{border:0;background:none;color:var(--mute);cursor:pointer;padding:3px 6px;border-radius:6px}
.crumbs button:hover{background:var(--panel2);color:var(--text)}
.crumbs button:last-child{color:var(--text);font-weight:600}
.crumbs i{color:var(--line);font-style:normal}

.tools{display:flex;flex-wrap:wrap;gap:8px;padding:10px 14px;border-bottom:1px solid var(--line);align-items:center}
.btn{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--line);background:var(--panel2);padding:7px 12px;border-radius:8px;cursor:pointer;transition:border-color .15s,background .15s}
.btn:hover{border-color:#3a4868}
.btn.primary{background:var(--acc);border-color:var(--acc);color:#052e2a;font-weight:600}
.btn.primary:hover{filter:brightness(1.08)}
.btn.danger{background:var(--danger);border-color:var(--danger);color:#3b0a0a;font-weight:600}
.btn:disabled{opacity:.4;cursor:not-allowed}
.grow{flex:1}
.search{position:relative;min-width:140px;flex:1 1 160px;max-width:240px}
.search svg{position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--mute);width:16px;height:16px}
.search input{width:100%;background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:7px 10px 7px 32px}

#prog{height:3px;background:transparent;display:none}
#prog div{height:100%;width:0;background:var(--acc);transition:width .15s}

ul{list-style:none;margin:0;padding:0}
li{display:flex;align-items:center;gap:12px;padding:10px 14px;border-bottom:1px solid var(--line)}
li:last-child{border-bottom:0}
li:hover{background:#19212f}
.ic{width:36px;height:36px;border-radius:9px;display:grid;place-items:center;background:var(--panel2);color:var(--mute);flex:none}
.ic.d{background:#2a2416;color:var(--folder)}
.name{flex:1;min-width:0;text-align:left;background:none;border:0;padding:0;cursor:pointer}
.name b{display:block;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.name span{font-size:12px;color:var(--mute)}
.acts{display:flex;gap:2px;flex:none}
.ib{width:34px;height:34px;display:grid;place-items:center;border:0;background:none;border-radius:8px;color:var(--mute);cursor:pointer;transition:background .15s,color .15s}
.ib:hover{background:var(--panel2);color:var(--text)}
.ib.x:hover{background:#3a1a1e;color:var(--danger)}

.empty{padding:48px 20px;text-align:center;color:var(--mute)}
.empty .ic{margin:0 auto 12px;width:48px;height:48px}
.empty p{margin:4px 0 0}
.foot{padding:9px 14px;border-top:1px solid var(--line);font-size:12px;color:var(--mute)}

#drop{position:fixed;inset:0;background:rgba(14,19,28,.88);display:none;place-items:center;font-size:18px;color:var(--acc);border:2px dashed var(--acc);margin:10px;border-radius:16px;z-index:20}
#toasts{position:fixed;left:0;right:0;bottom:16px;display:flex;flex-direction:column;align-items:center;gap:8px;z-index:40;pointer-events:none}
.toast{background:var(--panel2);border:1px solid var(--line);padding:9px 14px;border-radius:9px;box-shadow:0 8px 24px rgba(0,0,0,.4);animation:in .18s ease-out}
.toast.err{border-color:var(--danger);color:#fecaca}
.toast.ok{border-color:var(--acc)}
@keyframes in{from{opacity:0;transform:translateY(8px)}}

#modal{position:fixed;inset:0;background:rgba(5,8,14,.65);display:grid;place-items:center;padding:16px;z-index:30}
#modal[hidden],#drop[hidden]{display:none}
.dlg{width:100%;max-width:400px;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:20px;animation:in .16s ease-out}
.dlg h3{margin:0 0 6px;font-size:16px}
.dlg p{margin:0 0 14px;color:var(--mute);word-break:break-all}
.dlg input{width:100%;background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:9px 11px;margin-bottom:14px}
.dlg .row{display:flex;justify-content:flex-end;gap:8px}
@media(max-width:480px){.btn span{display:none}.btn{padding:8px 10px}.search{max-width:none}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style></head><body>
<div class="app">
<header>
  <div class="brand"><div class="logo" id="logo"></div><div>ESP32 File Manager<small>QuбєЈn lГЅ tб»‡p trГЄn thiбєїt bб»‹</small></div></div>
  <div class="seg" role="tablist">
    <button id="tab-lfs" class="on" onclick="switchFS('lfs')"></button>
    <button id="tab-sd" onclick="switchFS('sd')"></button>
  </div>
</header>

<div class="card">
  <nav class="crumbs" id="crumbs" aria-label="ДђЖ°б»ќng dбє«n"></nav>
  <div class="tools">
    <button class="btn" id="bUp" onclick="goUp()" title="LГЄn thЖ° mб»Ґc cha"></button>
    <button class="btn" id="bDir" onclick="newFolder()"></button>
    <button class="btn" id="bFile" onclick="newFile()"></button>
    <button class="btn primary" id="bUpl" onclick="uploadFile()"></button>
    <button class="btn" id="bRef" onclick="refresh()" title="LГ m mб»›i"></button>
    <div class="search"><span id="sIc"></span><input id="q" type="search" placeholder="TГ¬m trong thЖ° mб»Ґc" oninput="render()"></div>
  </div>
  <div id="prog"><div></div></div>
  <ul id="list"></ul>
  <div class="foot" id="foot">&nbsp;</div>
</div>
</div>

<input type="file" id="fileUpload" multiple style="display:none" onchange="doUpload()">
<div id="drop" hidden>ThбєЈ tб»‡p Д‘б»ѓ tбєЈi lГЄn</div>
<div id="toasts"></div>
<div id="modal" hidden>
  <div class="dlg" role="dialog" aria-modal="true">
    <h3 id="mTitle"></h3><p id="mMsg"></p>
    <input id="mInput" autocomplete="off" spellcheck="false">
    <div class="row"><button class="btn" id="mCancel">Hб»§y</button><button class="btn primary" id="mOk">Дђб»“ng ГЅ</button></div>
  </div>
</div>

<script>
let curFS='lfs',curPath='/',sdAvailable=__SD__,items=[];
const $=s=>document.querySelector(s);
const P={
  folder:'<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  file:'<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/>',
  up:'<path d="M12 19V5M5 12l7-7 7 7"/>',
  dirPlus:'<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M12 10v6M9 13h6"/>',
  filePlus:'<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M12 12v6M9 15h6"/>',
  upload:'<path d="M12 16V4M6 10l6-6 6 6M4 20h16"/>',
  refresh:'<path d="M20 11a8 8 0 1 0-2.3 5.7M20 4v7h-7"/>',
  move:'<path d="M5 12h14M13 6l6 6-6 6"/>',
  edit:'<path d="M4 20h4L19 9l-4-4L4 16z"/>',
  trash:'<path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/>',
  chip:'<rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"/>',
  sd:'<path d="M7 3h8l4 4v12a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M9 7v3M12 7v3M15 7v3"/>',
  search:'<circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/>'
};
const ico=n=>'<svg viewBox="0 0 24 24">'+P[n]+'</svg>';
const btn=(id,i,t)=>{$(id).innerHTML=ico(i)+(t?'<span>'+t+'</span>':'')};
$('#logo').innerHTML=ico('chip');
btn('#tab-lfs','chip','LittleFS');btn('#tab-sd','sd','Thбє» SD');
btn('#bUp','up','');btn('#bDir','dirPlus','ThЖ° mб»Ґc');btn('#bFile','filePlus','Tб»‡p mб»›i');
btn('#bUpl','upload','TбєЈi lГЄn');btn('#bRef','refresh','');$('#sIc').innerHTML=ico('search');
if(!sdAvailable)$('#tab-sd').disabled=true;

function fmt(n){
  if(typeof n!=='number'){n=parseInt(n);if(isNaN(n))return'';}
  if(n<1024)return n+' B';
  if(n<1048576)return(n/1024).toFixed(1)+' KB';
  return(n/1048576).toFixed(2)+' MB';
}
function toast(msg,type){
  const t=document.createElement('div');t.className='toast '+(type||'');t.textContent=msg;
  $('#toasts').appendChild(t);setTimeout(()=>t.remove(),2800);
}
function ask(o){
  return new Promise(res=>{
    const m=$('#modal'),inp=$('#mInput'),ok=$('#mOk'),no=$('#mCancel'),msg=$('#mMsg');
    $('#mTitle').textContent=o.title;
    msg.textContent=o.msg||'';msg.hidden=!o.msg;
    inp.hidden=!o.input;inp.value=o.value||'';
    ok.textContent=o.ok||'Дђб»“ng ГЅ';ok.className='btn '+(o.danger?'danger':'primary');
    m.hidden=false;
    if(o.input){inp.focus();inp.select();}else ok.focus();
    const done=v=>{m.hidden=true;ok.onclick=no.onclick=m.onclick=inp.onkeydown=document.onkeydown=null;res(v)};
    ok.onclick=()=>done(o.input?inp.value.trim():true);
    no.onclick=()=>done(null);
    m.onclick=e=>{if(e.target===m)done(null)};
    inp.onkeydown=e=>{if(e.key==='Enter')ok.click()};
    document.onkeydown=e=>{if(e.key==='Escape')done(null)};
  });
}
async function api(url,opt){
  try{
    const r=await fetch(url,opt);
    if(!r.ok)throw new Error(r.status);
    return r;
  }catch(e){toast('Thao tГЎc thбєҐt bбєЎi, vui lГІng thб»­ lбєЎi','err');throw e;}
}
const qs=(p)=>'fs='+curFS+'&path='+encodeURIComponent(p);

function switchFS(fs){
  if(fs=='sd'&&!sdAvailable){toast('KhГґng tГ¬m thбєҐy thбє» SD','err');return;}
  curFS=fs;curPath='/';$('#q').value='';
  $('#tab-lfs').classList.toggle('on',fs=='lfs');
  $('#tab-sd').classList.toggle('on',fs=='sd');
  refresh();
}
function crumbs(){
  const nav=$('#crumbs');nav.innerHTML='';
  const parts=curPath.split('/').filter(Boolean);
  const add=(label,path)=>{
    if(nav.children.length){const s=document.createElement('i');s.textContent='/';nav.appendChild(s);}
    const b=document.createElement('button');b.textContent=label;
    b.onclick=()=>{curPath=path;refresh();};nav.appendChild(b);
  };
  add(curFS=='sd'?'Thбє» SD':'LittleFS','/');
  let acc='';parts.forEach(p=>{acc+='/'+p;add(p,acc);});
}
async function refresh(){
  crumbs();
  try{
    const r=await fetch('/api/list?'+qs(curPath));
    if(!r.ok)throw 0;
    const j=await r.json();items=j.items||[];
    items.sort((a,b)=>(b.dir-a.dir)||a.name.localeCompare(b.name));
    render();
  }catch(e){toast('KhГґng tбєЈi Д‘Ж°б»Јc danh sГЎch tб»‡p','err');}
}
function render(){
  const ul=$('#list');ul.innerHTML='';
  const q=$('#q').value.trim().toLowerCase();
  const view=items.filter(it=>!q||it.name.toLowerCase().includes(q));
  if(!view.length){
    ul.innerHTML='<div class="empty"><div class="ic">'+ico('folder')+'</div><b>'+(q?'KhГґng cГі kбєїt quбєЈ':'ThЖ° mб»Ґc trб»‘ng')+'</b><p>'+(q?'Thб»­ tб»« khГіa khГЎc.':'TбєЈi lГЄn hoбє·c tбєЎo tб»‡p mб»›i Д‘б»ѓ bбєЇt Д‘бє§u.')+'</p></div>';
  }
  view.forEach(it=>{
    const li=document.createElement('li');
    const ic=document.createElement('div');ic.className='ic'+(it.dir?' d':'');ic.innerHTML=ico(it.dir?'folder':'file');
    const a=document.createElement('button');a.className='name';
    const nm=document.createElement('b');nm.textContent=it.name;
    const meta=document.createElement('span');meta.textContent=it.dir?'ThЖ° mб»Ґc':fmt(it.size);
    a.append(nm,meta);
    a.onclick=()=>{
      if(it.dir){curPath=it.path;$('#q').value='';refresh();}
      else window.open('/api/download?'+qs(it.path));
    };
    const acts=document.createElement('div');acts.className='acts';
    const mk=(icn,title,fn,cls)=>{
      const b=document.createElement('button');b.className='ib '+(cls||'');b.title=title;b.setAttribute('aria-label',title);
      b.innerHTML=ico(icn);b.onclick=fn;acts.appendChild(b);
    };
    mk('move','Di chuyб»ѓn',()=>moveItem(it.path));
    mk('edit','Дђб»•i tГЄn',()=>renameItem(it.path));
    mk('trash','XГіa',()=>delItem(it.path),'x');
    li.append(ic,a,acts);ul.appendChild(li);
  });
  const nd=items.filter(i=>i.dir).length;
  $('#foot').textContent=nd+' thЖ° mб»Ґc, '+(items.length-nd)+' tб»‡p';
}
function goUp(){
  if(curPath=='/')return;
  let p=curPath.replace(/\/[^\/]+$/,'');if(p=='')p='/';
  curPath=p;refresh();
}
async function newFolder(){
  const n=await ask({title:'TбєЎo thЖ° mб»Ґc',input:true,value:'',ok:'TбєЎo'});if(!n)return;
  await api('/api/mkdir?'+qs(curPath)+'&name='+encodeURIComponent(n),{method:'POST'});
  toast('ДђГЈ tбєЎo thЖ° mб»Ґc','ok');refresh();
}
async function newFile(){
  const n=await ask({title:'TбєЎo tб»‡p mб»›i',input:true,value:'',ok:'TбєЎo'});if(!n)return;
  await api('/api/touch?'+qs(curPath)+'&name='+encodeURIComponent(n),{method:'POST'});
  toast('ДђГЈ tбєЎo tб»‡p','ok');refresh();
}
function uploadFile(){$('#fileUpload').click();}
function sendOne(f,i,total){
  return new Promise((res,rej)=>{
    const x=new XMLHttpRequest(),fd=new FormData();fd.append('file',f);
    x.open('POST','/api/upload?'+qs(curPath));
    x.upload.onprogress=e=>{if(e.lengthComputable)$('#prog div').style.width=((i+e.loaded/e.total)/total*100)+'%';};
    x.onload=()=>x.status<300?res():rej();
    x.onerror=rej;x.send(fd);
  });
}
async function upload(files){
  files=[...files];if(!files.length)return;
  const pr=$('#prog');pr.style.display='block';$('#prog div').style.width='0';
  let okc=0;
  for(let i=0;i<files.length;i++){
    try{await sendOne(files[i],i,files.length);okc++;}
    catch(e){toast('TбєЈi lГЄn thбєҐt bбєЎi: '+files[i].name,'err');}
  }
  pr.style.display='none';
  if(okc)toast('ДђГЈ tбєЈi lГЄn '+okc+' tб»‡p','ok');
  refresh();
}
async function doUpload(){const el=$('#fileUpload');await upload(el.files);el.value='';}
async function delItem(p){
  const ok=await ask({title:'XГіa mб»Ґc nГ y?',msg:p,ok:'XГіa',danger:true});if(!ok)return;
  await api('/api/delete?'+qs(p),{method:'POST'});
  toast('ДђГЈ xГіa','ok');refresh();
}
async function renameItem(p){
  const n=await ask({title:'Дђб»•i tГЄn',input:true,value:p.split('/').pop(),ok:'LЖ°u'});
  if(!n||n==p.split('/').pop())return;
  await api('/api/rename?'+qs(p)+'&name='+encodeURIComponent(n),{method:'POST'});
  toast('ДђГЈ Д‘б»•i tГЄn','ok');refresh();
}
async function moveItem(p){
  const d=await ask({title:'Di chuyб»ѓn Д‘бєїn',msg:p,input:true,value:curPath,ok:'Di chuyб»ѓn'});if(!d)return;
  await api('/api/move?'+qs(p)+'&dest='+encodeURIComponent(d),{method:'POST'});
  toast('ДђГЈ di chuyб»ѓn','ok');refresh();
}
/* kГ©o thбєЈ tб»‡p Д‘б»ѓ tбєЈi lГЄn */
let dc=0;
addEventListener('dragenter',e=>{if([...e.dataTransfer.types].includes('Files')){dc++;$('#drop').style.display='grid';}});
addEventListener('dragleave',()=>{if(--dc<=0){dc=0;$('#drop').style.display='none';}});
addEventListener('dragover',e=>e.preventDefault());
addEventListener('drop',e=>{e.preventDefault();dc=0;$('#drop').style.display='none';upload(e.dataTransfer.files);});
refresh();
</script></body></html>
